# ustidnr-mcp configuration
# Copy to .env and adjust as needed

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Transport: stdio (default, for Claude Desktop) or streamable-http (for web)
MCP_TRANSPORT=stdio

# HTTP server settings (only used with streamable-http transport)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# BZSt eVatR REST API endpoint
BZST_BASE_URL=https://api.evatr.vies.bzst.de/app/v1/abfrage

# HTTP request timeout in seconds
REQUEST_TIMEOUT=30.0

# Batch validation limits
BATCH_MAX_SIZE=100
BATCH_CONCURRENCY=10
